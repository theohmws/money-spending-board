# Supabase project used by the spending board (src/hooks/useSpendingBoard.ts).
# Required at build time — the app has no in-app "Connect Supabase" flow or
# demo-mode fallback; without these it renders a config-missing screen.
# Copy this file to .env.local and fill in the publishable key from
# https://supabase.com/dashboard/project/yjphlaymjjmbinhmdcqj/settings/api-keys
# (the new publishable/secret key pair Supabase is rolling out — use the
# "Publishable key", not the legacy anon key or the secret key).
NEXT_PUBLIC_SUPABASE_URL=https://yjphlaymjjmbinhmdcqj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Comma-separated list of Supabase OAuth provider ids (src/hooks/useAuthSession.ts)
# to show as "Continue with ___" buttons on the sign-in screen. Each provider
# must also be enabled in the Supabase dashboard under Auth > Providers.
# Defaults to "google" if unset; set to an empty string to disable OAuth
# sign-in entirely (email/password only).
NEXT_PUBLIC_SUPABASE_AUTH_PROVIDERS=google
