# Required: the repo deliberately mixes an ESLint 8-era toolchain (Airbnb
# configs have no flat-config release) with React 19/Next 16/Storybook 10,
# whose peerDependencies target ESLint 9+. Without this, `npm ci`/`npm install`
# fails with ERESOLVE on every fresh install (CI, Vercel, new clones).
legacy-peer-deps=true
